# ═══════════════════════════════════════════════════════════════
# CONFIGURATION — Veille Psycho → Scripts TikTok
# ═══════════════════════════════════════════════════════════════
# Copie ce fichier en ".env" et remplis chaque clé.
# Commande : copy .env.example .env

# ─────────────────────────────────────────────
# TRIGGER.DEV — Orchestration du pipeline
# ─────────────────────────────────────────────
# Récupère ta clé depuis le dashboard Trigger.dev :
# https://cloud.trigger.dev/ → ton projet → Settings → API Keys
TRIGGER_SECRET_KEY=tr_dev_xxxxx

# ─────────────────────────────────────────────
# GOOGLE AI — Gemini (scoring + génération)
# ─────────────────────────────────────────────
# Génère ta clé gratuite sur Google AI Studio :
# https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=AIzaSyxxxxx

# ─────────────────────────────────────────────
# NOTION — Base de données des scripts
# ─────────────────────────────────────────────
# Crée une intégration Notion :
# https://www.notion.so/my-integrations → New integration
# Puis connecte l'intégration à ta base de données
# (⋯ en haut de la page → Connections → ton intégration)
NOTION_API_KEY=ntn_xxxxx

# L'ID de ta base de données Notion
# Depuis l'URL : https://notion.so/ta-base-**abc123def456**?v=...
# L'ID c'est la partie en gras (32 caractères)
NOTION_DATABASE_ID=abc123def456
